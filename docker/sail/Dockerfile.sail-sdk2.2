# PyTorch-for-SAIL 2.14.1 build environment on T-Head SAIL SDK v2.2.1 (hggcrt3).
#
# The base image ships SDK v2.2.0; this Dockerfile replaces it with SDK
# v2.2.1 (a self-extracting .run installer) and upgrades PCCL to v2.2.2.
# The image provides the toolchain and Python build dependencies needed to
# compile the SAIL wheel, and ensures a matching PCCL library is present; the
# source tree is intentionally NOT baked in. The host Docker root filesystem is
# often small, and a full in-image compile would produce a 25-30 GB image, so
# build by bind-mounting the repository instead:
#
#   # 1) build this environment image (small: base + apt/pip layers). The build
#   #    context can be empty (this Dockerfile COPYs nothing); point docker at an
#   #    empty dir so the multi-GB source tree is not streamed to the daemon.
#   docker build -f Dockerfile.sail-sdk2.2 -t pytorch-sail-buildenv:2.14.1-sdk2.2.1 <empty-ctx-dir>
#
#   # 2) run the two-stage sailify build documented in README.md; build-sail.sh
#   #    (next to this file) wraps the same steps. Unlike 2.13, setup.py is a
#   #    PEP 517 shim with no sailify subcommand; stage one is
#   #    `python3 -m tools.sailify`.
#   #    By default, sailify converts the source tree in place, so the
#   #    bind-mounted repository is rewritten. To keep the checkout untouched,
#   #    convert out of place instead: add
#   #    -v /path/on/big/disk/sail-build:/workspace/sail-build and
#   #    -e SAILIFY_OUTPUT_DIR=/workspace/sail-build, pass
#   #    --output-dir "$SAILIFY_OUTPUT_DIR" to sailify, and cd there before the
#   #    pip install. Tune MAX_JOBS to the host CPU/RAM.
#   docker run --rm --name sail-build-v2141 \
#     -v "$PWD":/workspace/pytorch \
#     -e MAX_JOBS=128 \
#     pytorch-sail-buildenv:2.14.1-sdk2.2.1 \
#     bash -lc 'source "$PPU_SDK/envsetup.sh" && source "$PCCL_HOME/envsetup.sh" release && \
#               cd /workspace/pytorch && USE_SAIL=1 python3 -m tools.sailify && \
#               python3 -m pip install . --no-build-isolation -v'
#   # BUILD_TEST defaults to 1 (C++ test binaries included); add
#   # `-e BUILD_TEST=0` for a lean build.
#
#   # wheel: dist/torch-2.14.1-*.whl in the converted tree (the source tree
#   # for in-place builds).
#
# The base image ENTRYPOINT (/opt/t-head/entrypoint.sh) already sources the SDK
# and PCCL environments and then exec's the command above; the explicit `source`
# lines keep the build working even when the entrypoint is bypassed
# (--entrypoint /bin/bash). Python build deps are pre-installed in this image,
# so no `pip install -r requirements.txt` step is required. Building the image
# downloads the SDK v2.2.1 installer (~1.3 GB) and the PCCL v2.2.2 tarball
# (~274 MB) from the T-Head download portal on every full rebuild.
#
# NOTE: on some intranet hosts the build-container DNS resolves the T-Head
# download host to an internal node that rejects the download with 403, while
# the host itself resolves the public address. In that case pin the public IP
# with --add-host when building, e.g.:
#   docker build --add-host <download-host>:$(getent hosts <download-host> | awk '{print $1}') \
#     -f Dockerfile.sail-sdk2.2 -t pytorch-sail-buildenv:2.14.1-sdk2.2.1 <empty-ctx-dir>

# The public PPU sdk2.2.0-hggcrt3 image (ubuntu24.04 + py312); the SDK layer
# below replaces its bundled SDK with v2.2.1, so the base must ship the same
# hggcrt3 layout.
ARG BASE_IMAGE=<t-head-ppu-sdk-v2.2.0-hggcrt3-image>
FROM ${BASE_IMAGE}

USER root
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# SDK v2.2.1 replaces the v2.2.0 SDK bundled in the base image. The installer
# is a self-extracting .run that accepts --silent --prefix=<dir> and always
# creates a PPU_SDK/ directory under the prefix. Obtain the installer link from
# the T-Head Developer Center portal (artifact type = SAIL SDK, version
# ${SDK_VERSION}, hggcrt3 + ubuntu2404, e.g. the ppu_hggcrt3_ubuntu2404 .run):
#   https://developer.t-head.cn/download/index.html
ARG SDK_VERSION=2.2.1
ARG SDK_RUN_URL=<ppu-sdk-v2.2.1-run-url>

# PCCL is distributed separately from the SAIL SDK. Resolution order:
#   1) if PCCL_URL is supplied (the v2.2.2 release matching SDK v2.2.1),
#      download that package and extract it into /usr/local, replacing any
#      copy bundled in the base image;
#   2) otherwise, use the PCCL already bundled in the base image (pccl.h +
#      libpccl.so under $PCCL_HOME) when present;
#   3) otherwise fail with instructions to fetch the matching package from the
#      T-Head Developer Center: https://developer.t-head.cn/download/index.html
#      (select by artifact type = PCCL library, version ${PCCL_VERSION}, hggcrt
#      generation ${PCCL_HGGCRT} and OS ${PCCL_OS}, e.g. ${PCCL_TARBALL}).
ARG PCCL_VERSION=2.2.2
ARG PCCL_HGGCRT=hggcrt3
ARG PCCL_OS=ubuntu2404
ARG PCCL_TARBALL=pccl_${PCCL_HGGCRT}_${PCCL_OS}-v${PCCL_VERSION}.tar.gz
ARG PCCL_URL=<pccl-v2.2.2-package-url>

LABEL org.opencontainers.image.title="PyTorch-for-SAIL SDK v2.2.1 build environment" \
      org.opencontainers.image.description="Toolchain (SDK v2.2.1 + PCCL v2.2.2) and Python build deps to compile the PyTorch-for-SAIL 2.14.1 (SAIL / hggcrt3) wheel"

# SAIL native build defaults. PCCL is distributed separately from SDK v2.2 and
# lives at /usr/local/pccl in this image (no nccl_wrapper: pure SAIL, no CUDA
# compat layer). PYTORCH_SAIL_ARCH defaults to the dual-architecture mix.
# USE_PCCL / USE_FLASH_ATTENTION / USE_MEM_EFF_ATTENTION / BUILD_TEST mirror
# README's build. PYTORCH_BUILD_VERSION is 2.14.1, derived from version.txt
# (2.14.1a0); it must match the tree's major version or the stable-ABI shim
# macros drift and the build fails. BUILD_TEST=1 also compiles the C++ test
# binaries; set BUILD_TEST=0 for a lean build. MAX_JOBS=128 suits shared build
# hosts; override per host.
ENV DEBIAN_FRONTEND=noninteractive \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    PIP_ROOT_USER_ACTION=ignore \
    PPU_SDK=/usr/local/PPU_SDK \
    PCCL_HOME=/usr/local/pccl \
    PCCL_INCLUDE_DIR=/usr/local/pccl/include \
    PCCL_LIB_DIR=/usr/local/pccl/lib \
    USE_SAIL=1 \
    USE_PCCL=1 \
    USE_FLASH_ATTENTION=1 \
    USE_MEM_EFF_ATTENTION=1 \
    PYTORCH_SAIL_ARCH="ppu_10;ppu_15" \
    PYTORCH_VERSION=2.14.1 \
    PYTORCH_BUILD_VERSION=2.14.1 \
    PYTORCH_BUILD_NUMBER=0 \
    USE_DISTRIBUTED=1 \
    BUILD_CAFFE2=0 \
    BUILD_TEST=1 \
    MAX_JOBS=128

# Replace the SDK bundled in the base image (v2.2.0) with SDK v2.2.1. The
# installer always creates a PPU_SDK/ directory under --prefix, so install
# into a staging dir and move the tree over /usr/local/PPU_SDK for a clean
# swap. `torch.version.ppu` is derived from release.yaml, so the wheel built
# in this image is stamped with 2.2.1-184ee6.
RUN set -eux; \
    test "${SDK_RUN_URL}" != "<ppu-sdk-v2.2.1-run-url>" || { \
        echo "ERROR: SDK_RUN_URL not supplied (placeholder default)." >&2; \
        echo "Get the SDK v${SDK_VERSION} (hggcrt ${PCCL_HGGCRT}, ${PCCL_OS}) .run installer from" >&2; \
        echo "https://developer.t-head.cn/download/index.html and pass --build-arg SDK_RUN_URL=<link>." >&2; \
        exit 1; \
    }; \
    stage=/tmp/sdk-stage; \
    mkdir -p "${stage}"; \
    curl -fL --retry 3 --retry-delay 2 --connect-timeout 20 -o /tmp/ppu-sdk.run "${SDK_RUN_URL}"; \
    bash /tmp/ppu-sdk.run --silent --prefix="${stage}"; \
    rm -f /tmp/ppu-sdk.run; \
    test -f "${stage}/PPU_SDK/release.yaml"; \
    rm -rf /usr/local/PPU_SDK; \
    mv "${stage}/PPU_SDK" /usr/local/PPU_SDK; \
    rmdir "${stage}"; \
    grep -E "^version: ${SDK_VERSION}" /usr/local/PPU_SDK/release.yaml

# cmake (>=3.27), ninja and ccache come from APT; the pip index lacks cmake.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        ccache \
        cmake \
        git \
        ninja-build \
        patch \
        pkg-config \
        libopenblas-dev \
        libjpeg-dev \
        libpng-dev \
    && rm -rf /var/lib/apt/lists/* \
    && git config --global --add safe.directory '*'

# Ensure the requested PCCL is present: download from PCCL_URL when supplied
# (v2.2.2, replacing the copy bundled in the base image); an explicitly empty
# PCCL_URL falls back to the base image copy; the placeholder default fails
# with instructions to get the package from
# https://developer.t-head.cn/download/index.html .
RUN set -eux; \
    fail_pccl() { \
        echo "ERROR: ${1}" >&2; \
        echo "Download the matching PCCL package from https://developer.t-head.cn/download/index.html" >&2; \
        echo "  artifact type: PCCL library; version ${PCCL_VERSION}; hggcrt ${PCCL_HGGCRT}; OS ${PCCL_OS}" >&2; \
        echo "  e.g. ${PCCL_TARBALL}; extract with: tar zxf ${PCCL_TARBALL} -C /usr/local" >&2; \
        echo "Then rebuild, or pass --build-arg PCCL_URL=<link obtained from the portal>." >&2; \
        exit 1; \
    }; \
    if [ -n "${PCCL_URL:-}" ] && [ "${PCCL_URL}" != "<pccl-v2.2.2-package-url>" ]; then \
        tarball="/tmp/${PCCL_TARBALL}"; \
        curl -fL --retry 3 --retry-delay 2 --connect-timeout 20 -o "${tarball}" "${PCCL_URL}"; \
        rm -rf /usr/local/pccl; \
        tar zxf "${tarball}" -C /usr/local; \
        rm -f "${tarball}"; \
        echo "PCCL ${PCCL_VERSION} installed from the download URL"; \
    elif [ "${PCCL_URL:-}" = "<pccl-v2.2.2-package-url>" ]; then \
        fail_pccl "PCCL_URL not supplied (placeholder default)."; \
    elif [ -f "${PCCL_INCLUDE_DIR}/pccl.h" ] && [ -e "${PCCL_LIB_DIR}/libpccl.so" ]; then \
        echo "PCCL: using the copy bundled in the base image (${PCCL_HOME})"; \
    else \
        fail_pccl "no PCCL in the base image and PCCL_URL is empty."; \
    fi; \
    test -f "${PCCL_INCLUDE_DIR}/pccl.h"; \
    test -e "${PCCL_LIB_DIR}/libpccl.so"; \
    grep -E '^version:' "${PCCL_HOME}/release.yaml"; \
    ls -l "${PCCL_LIB_DIR}"/libpccl.so*

# Python build deps. Mirrors requirements-build.txt minus cmake/ninja (APT
# provides them), plus the runtime libs setup.py imports while building the
# wheel. NOTE: PyTorch 2.14.1 adopts PEP 639 license-files, which requires
# setuptools>=77.0.0,<82 and packaging>=24.2; the base image ships setuptools
# 75.8.0 and no packaging, so both are installed/upgraded here.
# scikit-build-core (>=1.0, the pyproject build backend) and spin are also
# required by the 2.14.1 build chain.
#
# The pip index defaults to the TUNA mirror: pypi.org itself is reachable, but
# its wheel CDN (files.pythonhosted.org) stalls to ~14 kB/s on intranet build
# hosts and times out. Override with --build-arg PIP_INDEX_URL=<index>.
ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
RUN python3 -m pip install --no-cache-dir \
        --timeout 120 \
        --index-url "${PIP_INDEX_URL}" \
        "setuptools>=77.0.0,<82" \
        "scikit-build-core>=1.0" \
        spin \
        wheel \
        numpy \
        "packaging>=24.2" \
        pyyaml \
        requests \
        six \
        "typing-extensions>=4.15.0" \
        "sympy>=1.13.3" \
        "networkx>=2.5.1" \
        jinja2 \
        "fsspec>=0.8.5" \
        filelock \
        "optree>=0.13.0" \
        expecttest \
        hypothesis

# Fail fast if the SDK / PCCL layout, toolchain or PEP 639 build deps are not
# as expected. The SDK version grep asserts the base image SDK (v2.2.0) was
# successfully replaced by SDK v2.2.1; the setuptools/packaging version
# assertions guard the 2.14.1 license-files requirement.
RUN source "${PPU_SDK}/envsetup.sh" >/dev/null \
    && source "${PCCL_HOME}/envsetup.sh" release >/dev/null \
    && echo "SDK: $(grep -E '^version:' ${PPU_SDK}/release.yaml)" \
    && echo "PCCL: $(grep -E '^version:' ${PCCL_HOME}/release.yaml)" \
    && grep -qE '^version: 2\.2\.1' "${PPU_SDK}/release.yaml" \
    && grep -qE '^version: 2\.2\.2' "${PCCL_HOME}/release.yaml" \
    && echo "hgcc: $(hgcc --version 2>&1 | head -1)" \
    && echo "cmake: $(cmake --version | head -1)" \
    && echo "ninja: $(ninja --version)" \
    && python3 -c 'import numpy, packaging, yaml, setuptools, wheel; \
from packaging.version import Version; \
assert Version(setuptools.__version__) >= Version("77.0.0"), setuptools.__version__; \
assert Version(setuptools.__version__) < Version("82"), setuptools.__version__; \
assert Version(packaging.__version__) >= Version("24.2"), packaging.__version__; \
print("python build deps OK (setuptools " + setuptools.__version__ + ", packaging " + packaging.__version__ + ")")'

WORKDIR /workspace/pytorch
CMD ["/bin/bash"]
